{
  "expo": {
    "name": "React-Native-UI-Challenge",
    "slug": "React-Native-UI-Challenge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "reactnativeuichallenge",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./src/assets/icons/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/assets/images/android-icon-foreground.png",
        "backgroundImage": "./src/assets/images/android-icon-background.png",
        "monochromeImage": "./src/assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.boiipelo.ReactNativeUIChallenge"
    },
    "web": {
      "output": "single",
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./src/assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "1cb2969f-d26a-4bea-905a-4184c6ae8ae9"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1cb2969f-d26a-4bea-905a-4184c6ae8ae9"
    }
  }
}
